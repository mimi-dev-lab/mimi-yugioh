{
  "routes": [
    {
      "routePath": "/api/cards/external",
      "mountPath": "/api/cards",
      "method": "GET",
      "module": [
        "api/cards/external.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/cards/names",
      "mountPath": "/api/cards",
      "method": "GET",
      "module": [
        "api/cards/names.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/cards/resolve",
      "mountPath": "/api/cards",
      "method": "POST",
      "module": [
        "api/cards/resolve.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/cards/:id",
      "mountPath": "/api/cards",
      "method": "GET",
      "module": [
        "api/cards/[id].ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/decks/:id",
      "mountPath": "/api/decks",
      "method": "GET",
      "module": [
        "api/decks/[id].ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/cards",
      "mountPath": "/api/cards",
      "method": "GET",
      "module": [
        "api/cards/index.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/decks",
      "mountPath": "/api/decks",
      "method": "GET",
      "module": [
        "api/decks/index.ts:onRequestGet"
      ]
    }
  ],
  "baseURL": "/"
}