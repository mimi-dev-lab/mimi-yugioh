  "basics": {
    "core_mechanic": "利用「白森林」卡片需要魔法陷阱作为Cost的特性，结合「百夫长」卡片作为永续陷阱贴在后场的特点，将百夫长卡片作为Cost送墓，既满足白森林发动条件，又触发百夫长的墓地效果或再利用。同时通过《骑士皇 阿克西拉》连接两个系统。",
    "key_cards": [
      {"id": 71858682, "name_cn": "骑士皇 阿克西拉", "role": "系统桥梁", "explanation": "12星同调怪兽。能检索「百夫长」卡片，从而让白森林展开接入百夫长系统。同时赋予后场破坏耐性。"},
      {"id": 25592142, "name_cn": "白森林的阿斯特莉亚", "role": "最强初动", "explanation": "能从卡组拉光属性魔法师族调整，直接拉出百夫长核心《重骑士 普莉梅拉》或白森林调整。"},
      {"id": 15005145, "name_cn": "重骑士 普莉梅拉", "role": "双轴核心", "explanation": "光属性魔法师族调整，既是百夫长的核心，也符合白森林的种族支持。作为永续陷阱时可作为白森林的Cost。"}
    ]
  },
